{
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "semi": true,
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.css",
      "options": { "parser": "css" }
    },
    {
      "files": "*.html",
      "options": { "parser": "html", "bracketSameLine": false }
    }
  ]
}